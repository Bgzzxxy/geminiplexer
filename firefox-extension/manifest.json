{
  "manifest_version": 2,
  "name": "Gemini Cookie Injector",
  "version": "1.0.0",
  "description": "Ambil cookies sesi Gemini/Google (termasuk HttpOnly) lalu injek otomatis ke geminiplexer gateway.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*", "https://accounts.google.com/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Cookie Injector",
    "default_icon": {
      "48": "icon48.png",
      "96": "icon96.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  }
}